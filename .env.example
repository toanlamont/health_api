# Copy to .env and fill in. Run with: uvicorn main:app --env-file .env

# --- Database ---
# Defaults to a local SQLite file (./health.db) when unset.
DATABASE_URL=postgresql://user:password@localhost:5432/health

# --- Auth ---
# Signs the login tokens and the email verification codes. Use a long random
# string in production, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# --- AI chat (/api/v1/chat) ---
# LiteLLM model string, "<provider>/<model>". Default: gemini/gemini-2.5-flash
CHAT_MODEL=gemini/gemini-2.5-flash
# Key for the provider in CHAT_MODEL; LiteLLM picks it up by name
# (GEMINI_API_KEY for gemini/, ANTHROPIC_API_KEY for anthropic/, OPENAI_API_KEY for openai/).
# Gemini keys: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Messages each user may send to the model per rolling hour / day.
CHAT_LIMIT_HOURLY=30
CHAT_LIMIT_DAILY=100

# --- Email (sign-up verification codes) ---
# Leave SMTP_HOST empty in development: nothing is sent and the code is
# printed to the server log instead.
# Port 587 = STARTTLS, 465 = SSL. For Gmail, SMTP_PASSWORD is an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=HeartBeat <no-reply@example.com>

# --- Heart-rate captures ---
# Every analysed signal is archived to captures/ (last 50 kept) for debugging.
# Set to 0 to turn that off.
HEARTBEAT_SAVE_CAPTURES=1
