# --- Personal data ---
# health.db holds real accounts: email addresses and password hashes. captures/
# holds colour means taken off someone's face along with the timestamps of when
# they were sitting in front of the camera. Neither belongs in a repository,
# and once pushed they stay in the history even after a later delete.
*.db
*.sqlite
*.sqlite3
captures/

# --- Secrets ---
# SECRET_KEY signs the auth tokens; anyone holding it can mint a valid login.
.env
.env.*
!.env.example

# --- Virtual environment ---
# 4.8 GB, most of it CUDA libraries from torch. Rebuild it from
# requirements.txt instead, and install torch from the CUDA index as the note
# in that file says.
venv/
.venv/
env/

# --- Python build artefacts ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
build/
dist/

# --- Runtime output ---
server.log
*.log
